APP_ENV=development
DEBUG=false

# mock works offline; use openai to enable model-generated match analysis.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=30

DATABASE_URL=postgresql+asyncpg://careerpilot:careerpilot@localhost:5432/careerpilot
REDIS_URL=redis://localhost:6379/0

# Resume upload limits. Only text-based PDF and DOCX files are accepted.
MAX_UPLOAD_SIZE_MB=5
MAX_EXTRACTED_TEXT_CHARACTERS=50000
